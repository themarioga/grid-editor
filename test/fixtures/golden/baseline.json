  "5x-auto": {
    "html": "<div class=\"row\"><div class=\"col-lg-12 column\"><h2>With elements.auto, every child of a content area was an element.</h2><p>This paragraph was one.</p><blockquote><p>And so was this quote.</p></blockquote></div></div>\n",
    "plain": "<div class=\"row\"><div class=\"col-lg-12\"><h2>With elements.auto, every child of a content area was an element.</h2><p>This paragraph was one.</p><blockquote><p>And so was this quote.</p></blockquote></div></div>\n"
  },
  "5x-between": {
    "html": "<div class=\"row\"><div class=\"col-lg-12 column\"><div class=\"ge-content\" data-ge-content-type=\"tinymce\">\n    <p>Text before the quote.</p>\n    </div><blockquote data-ge-element=\"quote\" data-ge-label=\"Pull quote\"><p>The quote.</p></blockquote><div class=\"ge-content ge-content-type-tinymce\" data-ge-content-type=\"tinymce\">\n    <p>Text between the quote and the figure.</p>\n    </div><figure data-ge-element=\"figure\"><figcaption>A figure</figcaption></figure><div class=\"ge-content ge-content-type-tinymce\" data-ge-content-type=\"tinymce\">\n    <p>Text after the figure.</p>\n</div></div></div>\n",
    "plain": "<div class=\"row\"><div class=\"col-lg-12\">\n    <p>Text before the quote.</p>\n    <blockquote><p>The quote.</p></blockquote>\n    <p>Text between the quote and the figure.</p>\n    <figure><figcaption>A figure</figcaption></figure>\n    <p>Text after the figure.</p>\n</div></div>\n"
  },
